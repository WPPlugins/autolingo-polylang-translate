msgstr "Caractères achetés restants : %s."

#, php-format
msgid "Buy %1$s characters (%2$s)"
msgstr "Acheter %1$s caractères (%2$s)"

msgid "One payment, through Stripe. Bought characters never expire: they are used once the month's are."
msgstr "Un seul paiement, par Stripe. Les caractères achetés n'expirent jamais : ils servent une fois ceux du mois épuisés."

msgid "AutoLingo AI (included, no key)"
msgstr "IA AutoLingo (incluse, sans clé)"

