#. Plugin Name of the plugin
#: autolingo-polylang-translate.php
msgid "AutoLingo — Automatic Translation for Polylang & WPML"
msgstr "AutoLingo — Traduction automatique pour Polylang et WPML"

#. Plugin URI of the plugin
#: autolingo-polylang-translate.php
msgid "https://auto-lingo.com"
msgstr "https://auto-lingo.com"

#. Description of the plugin
#: autolingo-polylang-translate.php
msgid "Automatic translation via DeepL, OpenAI or Google Translate. Works with Polylang and WPML. Supports Elementor, Beaver Builder, Bricks, WooCommerce, ACF, and all major SEO plugins."
msgstr "Traduction automatique avec DeepL, OpenAI ou Google Translate. Fonctionne avec Polylang et WPML. Prend en charge Elementor, Beaver Builder, Bricks, WooCommerce, ACF et les principales extensions SEO."

