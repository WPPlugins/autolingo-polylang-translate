#. Plugin Name of the plugin
#: autolingo-polylang-translate.php
msgid "AutoLingo — Automatic Translation for Polylang & WPML"
msgstr "AutoLingo — Automatische Übersetzung für Polylang & WPML"

#. Plugin URI of the plugin
#: autolingo-polylang-translate.php
msgid "https://auto-lingo.com"
msgstr "https://auto-lingo.com"

#. Description of the plugin
#: autolingo-polylang-translate.php
msgid "Automatic translation via DeepL, OpenAI or Google Translate. Works with Polylang and WPML. Supports Elementor, Beaver Builder, Bricks, WooCommerce, ACF, and all major SEO plugins."
msgstr "Automatische Übersetzung mit DeepL, OpenAI oder Google Translate. Funktioniert mit Polylang und WPML. Unterstützt Elementor, Beaver Builder, Bricks, WooCommerce, ACF und alle großen SEO-Plugins."

